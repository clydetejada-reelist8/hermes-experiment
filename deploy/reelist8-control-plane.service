[Unit]
Description=REELIST8 Hermes Control Plane API
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=hermes
Group=hermes
WorkingDirectory=/home/hermes/reelist8-hermes-experiment
EnvironmentFile=/home/hermes/.hermes/reelist8-control-plane.env
ExecStart=/usr/bin/env bash -lc 'exec npx --yes pnpm@10.12.1 --filter @hermes/api start'
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
