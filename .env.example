# Hermes staging environment configuration.
# Safe placeholders only. Never commit real secrets.
# Inject real values through the staging secrets system.

NODE_ENV=staging
APP_BASE_URL=http://localhost:3000
API_PORT=3000
INTERNAL_SERVICE_TOKEN=replace-with-staging-internal-service-token
DATABASE_URL=postgresql://hermes:hermes@localhost:5432/hermes_staging
REDIS_URL=redis://localhost:6379
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=hermes-staging
OBJECT_STORAGE_ACCESS_KEY=replace-with-staging-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-staging-secret-key
TOKEN_ENCRYPTION_KEY=replace-with-64-char-hex-encryption-key
DISCORD_BOT_TOKEN=replace-with-staging-bot-token
DISCORD_APPLICATION_ID=replace-with-staging-application-id
DISCORD_GUILD_ID=replace-with-staging-guild-id
DISCORD_ASK_CHANNEL_ID=replace-with-ask-channel-id
DISCORD_UPLOAD_CHANNEL_ID=replace-with-upload-channel-id
GOOGLE_CLIENT_ID=replace-with-staging-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-staging-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/v1/google/oauth/callback
OPENAI_API_KEY=replace-with-staging-openai-key
OPENAI_REASONING_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: point both LLM and embedding calls at an OpenAI-compatible endpoint
# (e.g. a Nous Research free API, a self-hosted vLLM/Ollama server).
# Leave commented to use OpenAI directly.
#OPENAI_BASE_URL=https://api.nousresearch.com/v1
# Optional: separate base URLs when the chat provider doesn't support embeddings
# (e.g. a ChatGPT/Codex subscription for chat, OpenAI direct for embeddings).
# These override OPENAI_BASE_URL for their respective surface.
#OPENAI_LLM_BASE_URL=https://api.codex.example.com/v1
#OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# Optional: separate API keys per surface. Falls back to OPENAI_API_KEY.
#OPENAI_LLM_API_KEY=replace-with-codex-sub-key
#OPENAI_EMBEDDING_API_KEY=replace-with-openai-embedding-key
UPLOAD_MAX_BYTES=10485760
SOURCE_ACCESS_CACHE_TTL_SECONDS=300
STAGING_GOOGLE_HOSTED_DOMAIN=
STAGING_EMAIL_RECIPIENT_ALLOWLIST=
STAGING_RETENTION_CONVERSATION_DAYS=30
STAGING_RETENTION_THREAD_ARTIFACT_DAYS=7
STAGING_RETENTION_AUDIT_DAYS=90
STAGING_RETENTION_ACTION_DAYS=90
